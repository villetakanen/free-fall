---
import {
  type NavModel,
  normalizeNavigation,
  type RenderNavModel,
} from "../navigation";
import AppBar from "./AppBar.astro";
import AppTray from "./AppTray.astro";
import FontLinks from "./FontLinks.astro";
import "../styles/base.css";

interface LegacyNavItem {
  icon: string;
  label: string;
  href: string;
  active?: boolean;
  variant?: "nav" | "uplink";
  subItems?: {
    label: string;
    href: string;
    active?: boolean;
  }[];
}

interface Props {
  title: string;
  navigation?: NavModel;
  /** Temporary compatibility input while consuming apps migrate to NavModel. */
  navItems?: LegacyNavItem[];
  brandHref?: string;
}

const { title, navigation, navItems, brandHref } = Astro.props;

const legacyRenderModel = (items: LegacyNavItem[]): RenderNavModel => ({
  scope: items[0]?.variant === "uplink" ? "subsite" : "global",
  label: "Main navigation",
  items: items.map((item) => {
    if (item.variant === "uplink") {
      return {
        kind: "uplink" as const,
        icon: item.icon,
        label: item.label,
        href: item.href,
        active: false as const,
        current: false as const,
      };
    }

    return {
      kind: "link" as const,
      icon: item.icon,
      label: item.label,
      href: item.href,
      active: item.active ?? false,
      current: item.active ?? false,
      children: item.subItems?.map((subItem) => ({
        kind: "link" as const,
        icon: "",
        label: subItem.label,
        href: subItem.href,
        active: subItem.active ?? false,
        current: subItem.active ?? false,
      })),
    };
  }),
});

if (!navigation && !navItems) {
  throw new Error("AppShell requires a navigation model");
}

const renderNavigation = navigation
  ? normalizeNavigation(navigation, Astro.url.pathname)
  : legacyRenderModel(navItems ?? []);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontLinks />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="app-shell">
      <AppTray navigation={renderNavigation} brandHref={brandHref} />
      <div class="app">
        <AppBar title={title} />
        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  /*
 * This style is scoped to app-shell only, it's not used elswhere in the app
 */
  .app-shell {
    display: flex;
    flex-direction: row;
    height: 100dvh;
    width: 100dvw;
    overflow: hidden;
  }
  .app-shell > .app {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: 100%;
  }
  .app-shell main {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    overflow-y: auto;
    container-type: inline-size;
    container-name: content;
  }
</style>
