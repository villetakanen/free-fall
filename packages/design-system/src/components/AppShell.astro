---
import AppBar from "./AppBar.astro";
import AppTray from "./AppTray.astro";
import FontLinks from "./FontLinks.astro";
import "../styles/base.css";

interface NavItem {
  icon: string;
  label: string;
  href: string;
  active?: boolean;
  variant?: "nav" | "uplink";
  subItems?: {
    label: string;
    href: string;
    active?: boolean;
  }[];
}

interface Props {
  title: string;
  navItems: NavItem[];
  brandHref?: string;
}

const { title, navItems, brandHref } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontLinks />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const isDesktop = window.innerWidth >= 1024;
          const stored = localStorage.getItem("freefall_tray_state");
          if (isDesktop) {
            if (stored === "collapsed") {
              document.documentElement.classList.add("tray-collapsed");
            } else {
              document.documentElement.classList.add("tray-expanded");
            }
          } else {
            document.documentElement.classList.add("tray-collapsed");
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="app-shell">
      <AppTray items={navItems} brandHref={brandHref} />
      <div class="workspace">
        <div class="app">
          <AppBar title={title} />
          <main>
            <slot />
          </main>
        </div>
        <slot name="hud" />
      </div>
    </div>
  </body>
</html>

<style>
  /*
 * This style is scoped to app-shell only, it's not used elswhere in the app
 */
  .app-shell {
    display: flex;
    flex-direction: row;
    height: 100dvh;
    width: 100dvw;
    overflow: hidden;
  }
  .workspace {
    container-type: inline-size;
    container-name: hud-host;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }
  .workspace > .app {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: 100%;
  }
  .app-shell main {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    overflow-y: auto;
    container-type: inline-size;
    container-name: content;
  }
</style>
