---
interface Props {
  /**
   * Optional ID for the internal checkbox.
   * Useful if you need to control or query the state externally.
   */
  id?: string;
  controls?: string;
  label?: string;
}

const {
  id = "hamburger-toggle",
  controls,
  label = "Toggle navigation",
} = Astro.props;
---

<div class="hamburger-btn">
    <input type="checkbox" id={id} class="toggle" aria-hidden="true" tabindex="-1" />

    <label
      id={`${id}-trigger`}
      for={id}
      class="target"
      role="button"
      tabindex="0"
      aria-label={label}
      aria-controls={controls}
      aria-expanded="false"
      data-hamburger-trigger
    >
        <div class="bars" aria-hidden="true">
            <span class="bar top"></span>
            <span class="bar middle"></span>
            <span class="bar bottom"></span>
        </div>
    </label>
</div>

<style>
  .hamburger-btn {
    --hamburger-size: calc(6 * var(--freefall-space-1));
    --hamburger-bar-width: calc(2.25 * var(--freefall-space-1));
    --hamburger-bar-height: calc(0.25 * var(--freefall-space-1));
    --hamburger-bar-gap: calc(0.5 * var(--freefall-space-1));
    --hamburger-transition: 270ms cubic-bezier(0.4, 0, 0.2, 1);

    position: relative;
    display: inline-flex;
  }

  .toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .target {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--hamburger-size);
    height: var(--hamburger-size);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color var(--hamburger-transition);
  }

  .target:hover {
    background: var(--freefall-action-hover);
  }

  .target:focus-visible {
    outline: calc(var(--freefall-space-1) / 4) solid
      var(--freefall-alert-base);
    outline-offset: calc(var(--freefall-space-1) / 2);
  }

  .bars {
    position: relative;
    width: var(--hamburger-bar-width);
    height: calc(
      (var(--hamburger-bar-height) * 3) + (var(--hamburger-bar-gap) * 2)
    );
  }

  .bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--hamburger-bar-height);
    background-color: var(--freefall-text-body);
    border-radius: 0;
    transition:
      transform var(--hamburger-transition),
      opacity var(--hamburger-transition),
      background-color var(--hamburger-transition);
  }

  .top {
    top: 0;
    transform-origin: center;
  }

  .middle {
    top: 50%;
    transform: translateY(-50%);
    transform-origin: right center;
  }

  .bottom {
    bottom: 0;
    transform-origin: center;
  }

  /* Animated :checked state ("X" cross) */

  .hamburger-btn:has(.toggle:checked) .middle {
    transform: translateY(-50%) scaleX(0.15);
    background-color: var(--freefall-text-link);
  }

  .hamburger-btn:has(.toggle:checked) .top {
    transform: translateY(
        calc(var(--hamburger-bar-height) + var(--hamburger-bar-gap))
      )
      skewY(45deg) scaleY(1.4142);
  }

  .hamburger-btn:has(.toggle:checked) .bottom {
    transform: translateY(
        calc((var(--hamburger-bar-height) + var(--hamburger-bar-gap)) * -1)
      )
      skewY(-45deg) scaleY(1.4142);
  }

  @media (prefers-reduced-motion: reduce) {
    .target,
    .bar {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLLabelElement>("[data-hamburger-trigger]")
    .forEach((trigger) => {
      const toggle = document.getElementById(
        trigger.htmlFor,
      ) as HTMLInputElement | null;
      if (!toggle) return;

      const syncExpanded = () => {
        trigger.setAttribute("aria-expanded", String(toggle.checked));
      };

      trigger.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        trigger.click();
      });
      toggle.addEventListener("change", syncExpanded);
      syncExpanded();
    });
</script>
