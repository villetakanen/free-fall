---
import DrawerBrand from "./DrawerBrand.astro";
import HamburgerButton from "./HamburgerButton.astro";
import TrayButton from "./TrayButton.astro";
import TrayLink from "./TrayLink.astro";
import TrayLinkGroup from "./TrayLinkGroup.astro";

/**
 * app-tray-drawer
 *
 * Owns HamburgerButton in the AppShell - as HamburgerButton should
 * never be rendered in the AppShell, unless the Tray exists in the dom.
 */

interface NavItem {
  icon: string;
  label: string;
  href: string;
  active?: boolean;
  /** "uplink" marks the exit from a subsite scope — see TrayButton. */
  variant?: "nav" | "uplink";
  subItems?: {
    label: string;
    href: string;
    active?: boolean;
  }[];
}

interface Props {
  items: NavItem[];
  brandHref?: string;
}

const { items, brandHref } = Astro.props;
---

<div class="app-tray">
  <HamburgerButton id="app-tray-toggle" controls="app-tray-drawer" />

  <div id="app-tray-drawer" class="drawer">
    <nav id="app-tray-nav" class="nav" aria-label="Main navigation">
      {
        items.map((item: NavItem) => (
          <>
            <TrayButton
              icon={item.icon}
              label={item.label}
              href={item.href}
              active={item.active}
              variant={item.variant}
            />
            {item.subItems && (
              <TrayLinkGroup active={item.active}>
                {item.subItems.map((subItem) => (
                  <TrayLink
                    href={subItem.href}
                    label={subItem.label}
                    active={subItem.active}
                  />
                ))}
              </TrayLinkGroup>
            )}
          </>
        ))
      }
    </nav>
    <DrawerBrand href={brandHref} />
  </div>

  <label
    for="app-tray-toggle"
    class="scrim"
    aria-hidden="true"></label>
</div>

<style>
  /* ── Tokens ─────────────────────────────────────────── */
  .app-tray {
    --app-tray-z-tray: 100;
    --app-tray-z-scrim: 99;
    --app-tray-rail-width: calc(10 * var(--freefall-space-1));
    --app-tray-tray-width: calc(40 * var(--freefall-space-1));
    --app-tray-burger-size: calc(6 * var(--freefall-space-1));
    --app-tray-icon-size: calc(3 * var(--freefall-space-1));

    display: flex;
    flex-direction: row;
    position: relative;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--freefall-bg-surface-1);
  }

  /* ── Hamburger (child component, needs :global) ───── */
  .app-tray > :global(.hamburger-btn) {
    position: fixed;
    top: var(--freefall-space-2);
    left: var(--freefall-space-2);
    z-index: calc(var(--app-tray-z-tray) + 2);
  }

  /* ── Drawer column ─────────────────────────────────── */
  .drawer {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--freefall-bg-surface-1);
    container-type: inline-size;
    padding-top: calc(
      var(--app-tray-burger-size) + 2 * var(--freefall-space-2)
    );
    padding-bottom: var(--freefall-space-2);
    padding-left: calc(var(--freefall-space-1) * 1.5);
    padding-right: calc(var(--freefall-space-1) * 1.5);
  }

  /* ── Nav (scrollable region) ───────────────────────── */
  .nav {
    display: flex;
    flex-direction: column;
    gap: var(--freefall-space-1);
    align-items: flex-start;
    flex: 1;
    min-height: 0;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
  }

  /* ── Scrim ─────────────────────────────────────────── */
  .scrim {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--app-tray-z-scrim);
    background: var(--freefall-bg-canvas);
    opacity: 0;
    transition: opacity 150ms ease-in;
    cursor: pointer;
  }

  /* ── Mobile (< 620px): off-screen modal drawer + scrim ── */
  @media (max-width: 619px) {
    .app-tray {
      width: 0;
    }

    .drawer {
      position: fixed;
      top: 0;
      left: 0;
      z-index: var(--app-tray-z-tray);
      width: var(--app-tray-tray-width);
      max-width: 100vw;
      transform: translateX(-100%);
      transition:
        transform 150ms ease-in,
        width 150ms ease-in;
      border-right: none;
    }

    .app-tray:has(#app-tray-toggle:checked) .drawer {
      transform: translateX(0);
      transition:
        transform 200ms ease-out,
        width 200ms ease-out;
    }

    .app-tray:has(#app-tray-toggle:checked) .scrim {
      display: block;
      opacity: 0.6;
      transition: opacity 200ms ease-out;
    }
  }

  /* ── Tablet (620px – 1023px): rail + overlay tray ──── */
  @media (min-width: 620px) and (max-width: 1023px) {
    .app-tray {
      width: var(--app-tray-rail-width);
      transition: 270ms width;
    }

    .drawer {
      position: relative;
      transform: translateX(0);
      width: var(--app-tray-rail-width);
      flex-shrink: 0;
      border-right: calc(var(--freefall-space-1) / 4) solid
        var(--freefall-border-subtle);
      z-index: calc(var(--app-tray-z-tray) + 1);
    }

    .app-tray:has(#app-tray-toggle:checked) .drawer {
      position: absolute;
      top: 0;
      left: 0;
      height: 100vh;
      width: var(--app-tray-tray-width);
    }

    .app-tray:has(#app-tray-toggle:checked) .scrim {
      display: block;
      opacity: 0.6;
      transition: opacity 200ms ease-out;
    }
  }

  /* ── Desktop (>= 1024px): Full site mode (open by default, pushes content) ── */
  @media (min-width: 1024px) {
    .app-tray {
      width: var(--app-tray-tray-width);
      transition: 270ms width;
    }

    .drawer {
      position: relative;
      transform: translateX(0);
      width: var(--app-tray-tray-width);
      flex-shrink: 0;
      border-right: calc(var(--freefall-space-1) / 4) solid
        var(--freefall-border-subtle);
      z-index: calc(var(--app-tray-z-tray) + 1);
      transition: width 270ms ease-out;
    }

    .scrim {
      display: none !important;
    }

    /* Collapsed state on desktop (persisted via html.tray-collapsed) */
    :global(html.tray-collapsed) .app-tray {
      width: var(--app-tray-rail-width);
    }

    :global(html.tray-collapsed) .app-tray .drawer {
      width: var(--app-tray-rail-width);
    }

    /* Expanded state on desktop (persisted via html.tray-expanded) */
    :global(html.tray-expanded) .app-tray {
      width: var(--app-tray-tray-width);
    }

    :global(html.tray-expanded) .app-tray .drawer {
      width: var(--app-tray-tray-width);
    }

    /* No-JS fallback on desktop: if checkbox is checked without html class, collapse */
    :global(html:not(.tray-expanded):not(.tray-collapsed)) .app-tray:has(#app-tray-toggle:checked) {
      width: var(--app-tray-rail-width);
    }
    :global(html:not(.tray-expanded):not(.tray-collapsed)) .app-tray:has(#app-tray-toggle:checked) .drawer {
      width: var(--app-tray-rail-width);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-tray,
    .drawer,
    .app-tray .drawer,
    .scrim {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById(
    "app-tray-toggle",
  ) as HTMLInputElement | null;
  const trigger = document.getElementById("app-tray-toggle-trigger");
  const drawer = document.getElementById("app-tray-drawer");

  if (toggle && trigger && drawer) {
    const STORAGE_KEY = "freefall_tray_state";
    const isOverlay = () => !window.matchMedia("(min-width: 1024px)").matches;
    const getFocusable = () =>
      drawer.querySelectorAll<HTMLElement>(
        'a, button, [tabindex]:not([tabindex="-1"])',
      );

    // Sync toggle checkbox with initial html state
    const isDesktop = !isOverlay();
    const isExpanded = document.documentElement.classList.contains("tray-expanded");
    if (isDesktop && isExpanded) {
      toggle.checked = true;
      trigger.setAttribute("aria-expanded", "true");
    } else if (document.documentElement.classList.contains("tray-collapsed")) {
      toggle.checked = false;
      trigger.setAttribute("aria-expanded", "false");
    }

    const setTrayState = (expanded: boolean, persist = true) => {
      toggle.checked = expanded;
      trigger.setAttribute("aria-expanded", String(expanded));

      if (expanded) {
        document.documentElement.classList.remove("tray-collapsed");
        document.documentElement.classList.add("tray-expanded");
        if (persist && !isOverlay()) {
          try {
            localStorage.setItem(STORAGE_KEY, "expanded");
          } catch {}
        }
        if (isOverlay()) {
          requestAnimationFrame(() => getFocusable()[0]?.focus());
        }
      } else {
        document.documentElement.classList.remove("tray-expanded");
        document.documentElement.classList.add("tray-collapsed");
        if (persist && !isOverlay()) {
          try {
            localStorage.setItem(STORAGE_KEY, "collapsed");
          } catch {}
        }
        trigger.focus();
      }
    };

    const closeTray = () => {
      setTrayState(false);
    };

    toggle.addEventListener("change", () => {
      setTrayState(toggle.checked);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.checked) {
        closeTray();
        return;
      }

      if (e.key === "Tab" && toggle.checked && isOverlay()) {
        const focusable = getFocusable();
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (!drawer.contains(document.activeElement)) {
          e.preventDefault();
          (e.shiftKey ? last : first).focus();
        } else if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    const mql = window.matchMedia("(min-width: 1024px)");
    mql.addEventListener("change", (e) => {
      if (e.matches) {
        const stored = localStorage.getItem(STORAGE_KEY);
        const shouldExpand = stored !== "collapsed";
        setTrayState(shouldExpand, false);
      } else {
        setTrayState(false, false);
      }
    });
  }
</script>
