---
import AppShell from "@free-fall/design-system/components/AppShell.astro";
import type { NavModel } from "@free-fall/design-system/navigation";

interface Props {
  title?: string;
  frontmatter?: { title?: string };
  /** Override global navigation for a scoped reference example. */
  navigation?: NavModel;
}

const title =
  Astro.props.title ||
  Astro.props.frontmatter?.title ||
  "FREE//FALL Design System";

/*
 * The sidebar is a reference index organized by the documentation taxonomy
 * (see specs/design-system/spec.md): Foundations, Primitives, Components,
 * Patterns. Each category is a `group` heading whose children are always shown
 * in the open tray. Home stays a top-level link so the collapsed rail has an
 * entry; category groups are open-tray-only, by design.
 */
const navigation: NavModel = Astro.props.navigation ?? {
  scope: "global",
  label: "Design system navigation",
  items: [
    { kind: "link", icon: "home", label: "Home", href: "/" },
    {
      kind: "group",
      label: "Foundations",
      children: [
        {
          kind: "link",
          icon: "palette",
          label: "Design Tokens",
          href: "/tokens/",
          match: "prefix",
        },
        {
          kind: "link",
          icon: "text_fields",
          label: "Typography",
          href: "/typography/",
        },
        {
          kind: "link",
          icon: "emoji_symbols",
          label: "Iconography",
          href: "/iconography/",
        },
      ],
    },
    {
      kind: "group",
      label: "Primitives",
      children: [
        {
          kind: "link",
          icon: "grid_view",
          label: "Content Grid",
          href: "/content-grid/",
        },
        { kind: "link", icon: "campaign", label: "Callout", href: "/callout/" },
        {
          kind: "link",
          icon: "list",
          label: "Definition List",
          href: "/definition-list/",
        },
      ],
    },
    {
      kind: "group",
      label: "Components",
      children: [
        {
          kind: "link",
          icon: "web_asset",
          label: "App Bar",
          href: "/app-bar/",
        },
        {
          kind: "link",
          icon: "dashboard",
          label: "App Shell",
          href: "/app-shell/",
        },
        { kind: "link", icon: "menu", label: "App Tray", href: "/app-tray/" },
        {
          kind: "link",
          icon: "bookmark",
          label: "Drawer Brand",
          href: "/drawer-brand/",
        },
        {
          kind: "link",
          icon: "style",
          label: "Gear Card",
          href: "/gear-card/",
        },
        {
          kind: "link",
          icon: "menu_open",
          label: "Hamburger Button",
          href: "/hamburger-button/",
        },
        {
          kind: "link",
          icon: "data_usage",
          label: "Stat Circle",
          href: "/stat-circle/",
        },
        {
          kind: "link",
          icon: "smart_button",
          label: "Tray Button",
          href: "/tray-button/",
        },
        { kind: "link", icon: "link", label: "Tray Link", href: "/tray-link/" },
        {
          kind: "link",
          icon: "format_list_bulleted",
          label: "Tray Link Group",
          href: "/tray-link-group/",
        },
      ],
    },
    {
      kind: "group",
      label: "Patterns",
      children: [
        {
          kind: "link",
          icon: "account_tree",
          label: "Navigation Model",
          href: "/navigation/",
        },
        {
          kind: "link",
          icon: "map",
          label: "Subsite Navigation",
          href: "/app-tray-subsite/",
        },
      ],
    },
  ],
};
---

<AppShell title={title} navigation={navigation} brandHref="/drawer-brand/">
  <div class="content-grid">
    <slot name="head" slot="head" />
    <slot />
  </div>
</AppShell>
