---
import type { NavModel } from "@free-fall/design-system/navigation";
// Spec: specs/design-system/app-tray/spec.md#contextual-navigation
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation: NavModel = {
  scope: "subsite",
  label: "Demo subsite navigation",
  items: [
    {
      kind: "uplink",
      label: "Design System",
      href: "/navigation/",
    },
    {
      kind: "link",
      icon: "map",
      label: "Demo Subsite",
      href: "/app-tray-subsite/",
    },
    {
      kind: "group",
      label: "Body Pages",
      children: [
        {
          kind: "link",
          icon: "article",
          label: "Body Page One",
          href: "/app-tray-subsite/#body-page-one",
        },
        {
          kind: "link",
          icon: "article",
          label: "Body Page Two",
          href: "/app-tray-subsite/#body-page-two",
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="App Tray: Subsite Mode — FREE//FALL Design System"
  navigation={navigation}
>
  <h1>App Tray: Subsite Mode</h1>
  <p>
    You are inside a <strong>subsite</strong> right now — look at the tray. The
    global design-system nav is gone; the tray renders a scoped set instead:
    an <em>uplink</em> first, then the subsite's own destinations and groups.
  </p>
  <p>
    The tray itself is unchanged and context-agnostic: it renders whatever
    <code>NavModel</code> the layout supplies. The model declares a subsite
    scope; rail, overlay, and push behavior stay identical to global
    navigation. Resize the browser to verify.
  </p>
  <p>
    This page is a <strong>navigation pattern</strong> demo, not a component
    reference — it lives under <em>Layout</em> in the styleguide nav, alongside
    Content Grid. Entering and leaving it <em>is</em> the demonstration.
  </p>

  <h2 id="body-pages">Body pages</h2>
  <p>
    In a real subsite (e.g. a scenario under <code>/scenarios/&lbrace;slug&rbrace;/</code>),
    each body page is a top-level item so read-in-order pages are one click
    away. Reference material (appendices) stays out of the rail — it is
    reached through the subsite's own overview page, keeping the rail to the
    read-through spine.
  </p>

  <h3 id="body-page-one">Body Page One</h3>
  <p>A local destination grouped under the scenario's read-through spine.</p>

  <h3 id="body-page-two">Body Page Two</h3>
  <p>Another local destination without a synthetic group route.</p>

  <p>
    <a href="/app-tray/">← To the App Tray reference page</a> — or leave
    through the tray's uplink. That's the point.
  </p>
</BaseLayout>
