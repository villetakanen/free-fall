---
import { getCollection, render } from "astro:content";
import GearCard from "@free-fall/design-system/components/GearCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { gearCategories } from "../../lib/nav.ts";

export async function getStaticPaths() {
  const entries = await getCollection("gear");

  return gearCategories
    .filter((c) => entries.some((e) => e.data.category === c.category))
    .map((c) => ({
      params: { category: c.slug },
      props: {
        label: c.label,
        items: entries
          .filter((e) => e.data.category === c.category)
          .sort((a, b) => a.data.title.localeCompare(b.data.title)),
      },
    }));
}

const { label, items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (entry: (typeof items)[number]) => ({
    id: entry.id,
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout title={`${label} — FREE//FALL`}>
  <div class="gear-listing breakout">
    {
      rendered.map(({ id, data, Content }) => (
        <article class="gear-item">
          <div class="gear-item__card-wrap">
            <GearCard data={data} {...data.binding} />
            <input
              type="checkbox"
              id={`modal-${id}`}
              class="modal-toggle"
              aria-hidden="true"
              tabindex="-1"
            />
            <label
              for={`modal-${id}`}
              class="expand-btn"
              role="button"
              tabindex="0"
              aria-label={`Show details for ${data.title}`}
              aria-controls={`details-${id}`}
              aria-expanded="false"
              data-modal-trigger
            >
              <span class="material-symbols-sharp" aria-hidden="true">
                add_circle
              </span>
            </label>

            <div class="modal-overlay">
              <label
                for={`modal-${id}`}
                class="modal-scrim"
                aria-hidden="true"
              />
              <div
                id={`details-${id}`}
                class="modal-content"
                role="dialog"
                aria-modal="true"
                aria-labelledby={`details-title-${id}`}
                tabindex="-1"
              >
                <label
                  for={`modal-${id}`}
                  class="modal-close"
                  role="button"
                  tabindex="0"
                  aria-label="Close details"
                  data-modal-close
                >
                  <span class="material-symbols-sharp" aria-hidden="true">
                    close
                  </span>
                </label>
                <div class="modal-prose">
                  <h2 id={`details-title-${id}`}>{data.title}</h2>
                  <Content />
                </div>
              </div>
            </div>
          </div>

          <div class="gear-item__description">
            <h2>{data.title}</h2>
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* ── Listing container ────────────────────────── */

  .gear-listing {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--freefall-space-1));
  }

  /* ── Item row ─────────────────────────────────── */

  .gear-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(3 * var(--freefall-space-1));
  }

  /* ── Card wrapper (holds card + expand button + modal) */

  .gear-item__card-wrap {
    position: relative;
  }

  /* ── Description pane (desktop only) ──────────── */

  .gear-item__description {
    display: none;
  }

  /* ── Expand button (mobile only) ──────────────── */

  .modal-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .expand-btn {
    position: absolute;
    top: calc(1 * var(--freefall-space-1));
    right: calc(1 * var(--freefall-space-1));
    z-index: 2;
    cursor: pointer;
    color: var(--freefall-color-primary-50);
    font-size: calc(4 * var(--freefall-space-1));
    line-height: 1;
    text-shadow: var(--freefall-text-shadow-overlay);
  }

  .expand-btn .material-symbols-sharp {
    font-size: inherit;
  }

  .expand-btn:focus-visible,
  .modal-close:focus-visible {
    outline: calc(var(--freefall-space-1) / 4) solid
      var(--freefall-color-accent-400);
    outline-offset: calc(var(--freefall-space-1) / 2);
  }

  /* ── Modal overlay ────────────────────────────── */

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    align-items: center;
    justify-content: center;
  }

  .modal-toggle:checked ~ .modal-overlay {
    display: flex;
  }

  .modal-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    z-index: 1;
    background: var(--freefall-bg-surface-1);
    border-radius: calc(2 * var(--freefall-space-1));
    border: calc(var(--freefall-space-1) / 4) solid var(--freefall-border-strong);
    max-width: 90vw;
    max-height: 85vh;
    overflow-y: auto;
    padding: calc(3 * var(--freefall-space-1));
  }

  .modal-close {
    position: absolute;
    top: calc(1.5 * var(--freefall-space-1));
    right: calc(1.5 * var(--freefall-space-1));
    cursor: pointer;
    color: var(--freefall-text-muted);
    font-size: calc(3 * var(--freefall-space-1));
    line-height: 1;
    z-index: 2;
  }

  .modal-close:hover {
    color: var(--freefall-text-display);
  }

  .modal-prose {
    color: var(--freefall-text-body);
  }

  .modal-prose > h2:first-child {
    margin-top: 0;
  }

  /* ── Desktop: side-by-side ────────────────────── */

  @media (min-width: 780px) {
    .gear-item {
      flex-direction: row;
      align-items: flex-start;
    }

    .gear-item__description {
      display: block;
      flex: 1;
      min-width: 0;
      color: var(--freefall-text-body);
    }

    .gear-item__description > h2:first-child {
      margin-top: 0;
    }

    .expand-btn {
      display: none;
    }

    .modal-toggle:checked ~ .modal-overlay {
      display: none;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLInputElement>(".modal-toggle");

  const getParts = (toggle: HTMLInputElement) => {
    const wrapper = toggle.closest(".gear-item__card-wrap");
    return {
      trigger: wrapper?.querySelector<HTMLElement>("[data-modal-trigger]"),
      dialog: wrapper?.querySelector<HTMLElement>('[role="dialog"]'),
      close: wrapper?.querySelector<HTMLElement>("[data-modal-close]"),
    };
  };

  const setModalOpen = (
    toggle: HTMLInputElement,
    open: boolean,
    restoreFocus = true,
  ) => {
    const { trigger, close } = getParts(toggle);
    toggle.checked = open;
    trigger?.setAttribute("aria-expanded", String(open));

    if (open) {
      toggles.forEach((other) => {
        if (other !== toggle && other.checked) {
          setModalOpen(other, false, false);
        }
      });
      requestAnimationFrame(() => close?.focus());
    } else if (restoreFocus) {
      trigger?.focus();
    }
  };

  toggles.forEach((toggle) => {
    toggle.addEventListener("change", () => {
      setModalOpen(toggle, toggle.checked);
    });
  });

  document.addEventListener("keydown", (event) => {
    const control = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-modal-trigger], [data-modal-close]",
    );
    if (control && (event.key === "Enter" || event.key === " ")) {
      event.preventDefault();
      control.click();
      return;
    }

    const open = document.querySelector<HTMLInputElement>(
      ".modal-toggle:checked",
    );
    if (!open) return;

    if (event.key === "Escape") {
      event.preventDefault();
      setModalOpen(open, false);
      return;
    }

    if (event.key !== "Tab") return;
    const { dialog } = getParts(open);
    if (!dialog) return;

    const focusable = dialog.querySelectorAll<HTMLElement>(
      'a, button, [tabindex]:not([tabindex="-1"])',
    );
    if (focusable.length === 0) {
      event.preventDefault();
      dialog.focus();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!dialog.contains(document.activeElement)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    } else if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
