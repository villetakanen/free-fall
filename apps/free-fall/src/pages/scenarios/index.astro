---
// Spec: specs/content-scenarios/spec.md#routes
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const scenarios = (await getCollection("scenarios"))
  .sort(
    (a, b) =>
      (a.data.order ?? Number.POSITIVE_INFINITY) -
        (b.data.order ?? Number.POSITIVE_INFINITY) ||
      a.data.title.localeCompare(b.data.title),
  )
  .map((entry) => ({
    href: `/scenarios/${entry.id.split("/")[0]}/`,
    ...entry.data,
  }));
---

<BaseLayout title="Scenarios — FREE//FALL">
  <h1>Scenarios</h1>

  {
    scenarios.length === 0 ? (
      <p class="scenario-list-empty">
        No scenarios published yet. The first job is being prepped — check
        back soon.
      </p>
    ) : (
      <ul class="scenario-list">
        {scenarios.map((s) => (
          <li>
            <a href={s.href}>{s.title}</a>
            <span class="scenario-list-meta">
              {s.type} · {s.system.variant} {s.system.version} · {s.length} ·{" "}
              {s.players.min}–{s.players.max} players
            </span>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .scenario-list-empty {
    color: var(--freefall-text-muted);
  }
  .scenario-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--freefall-space-1);
  }
  .scenario-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: calc(2 * var(--freefall-space-1));
  }
  .scenario-list-meta {
    font-family: var(--freefall-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--freefall-text-muted);
  }
</style>
