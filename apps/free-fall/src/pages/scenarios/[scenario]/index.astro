---
// Spec: specs/content-scenarios/spec.md#routes
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const scenarios = await getCollection("scenarios");
  const allPages = await getCollection("scenario-pages");

  return scenarios.map((entry) => {
    const slug = entry.id.split("/")[0];
    const pages = allPages
      .filter((p) => p.id.split("/")[0] === slug)
      .sort(
        (a, b) =>
          (a.data.order ?? Number.POSITIVE_INFINITY) -
            (b.data.order ?? Number.POSITIVE_INFINITY) ||
          a.data.title.localeCompare(b.data.title),
      )
      .map((p) => ({
        title: p.data.title,
        href: `/scenarios/${slug}/${p.id.split("/")[1]}/`,
      }));

    return {
      params: { scenario: slug },
      props: { entry, pages },
    };
  });
}

const { entry, pages } = Astro.props;
const { Content } = await render(entry);
const { type, system, length, players, content_warnings } = entry.data;
---

<BaseLayout title={`${entry.data.title} — FREE//FALL`}>
  <dl class="scenario-meta">
    <div>
      <dt>Type</dt>
      <dd>{type}</dd>
    </div>
    <div>
      <dt>System</dt>
      <dd>{system.variant} {system.version}</dd>
    </div>
    <div>
      <dt>Length</dt>
      <dd>{length}</dd>
    </div>
    <div>
      <dt>Players</dt>
      <dd>{players.min}–{players.max}</dd>
    </div>
    {
      content_warnings.length > 0 && (
        <div>
          <dt>Content warnings</dt>
          <dd>{content_warnings.join(", ")}</dd>
        </div>
      )
    }
  </dl>

  <Content />

  {
    pages.length > 0 && (
      <nav class="scenario-toc" aria-label="Scenario contents">
        <h2>Contents</h2>
        <ol>
          {pages.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
</BaseLayout>

<style>
  /* Inline strip layout; dt/dd element look comes from the design system
     (packages/design-system/src/styles/typography.css) */
  .scenario-meta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(2 * var(--freefall-space-1));
    margin: 0;
    padding-bottom: calc(2 * var(--freefall-space-1));
    border-bottom: 1px solid var(--freefall-border-subtle);
  }
  .scenario-meta dd {
    margin: 0;
  }
</style>
