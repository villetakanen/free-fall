---
import AppShell from "@free-fall/design-system/components/AppShell.astro";
import {
  getCoreRulebookNavItems,
  getGearNavItems,
  getScenarioNavItems,
  getScenarioSubsiteNav,
} from "../lib/nav.ts";

interface Props {
  title?: string;
  frontmatter?: { title?: string };
}

const title =
  Astro.props.title || Astro.props.frontmatter?.title || "FREE//FALL";

const pathname = Astro.url.pathname;

// A scenario is a subsite: inside one, the rail is scoped to that scenario.
// Segments of "/scenarios/{slug}/…" — slug present means we are inside a
// specific scenario (the "/scenarios/" listing has no slug).
const segments = pathname.split("/").filter(Boolean);
const scenarioSlug =
  segments[0] === "scenarios" && segments.length >= 2 ? segments[1] : null;

type NavItem = {
  icon: string;
  label: string;
  href: string;
  active: boolean;
  subItems?: { label: string; href: string; active: boolean }[];
};

let navItems: NavItem[];
if (scenarioSlug) {
  navItems = await getScenarioSubsiteNav(scenarioSlug, pathname);
} else {
  const coreRulebookSubItems = await getCoreRulebookNavItems(pathname);
  const gearNavItem = await getGearNavItems(pathname);
  const scenarioNavItem = await getScenarioNavItems(pathname);

  navItems = [
    {
      icon: "public",
      label: "Home",
      href: "/",
      active: pathname === "/",
    },
    {
      icon: "book_5",
      label: "Core Rules v7",
      href: "/core-rulebook/00-intro/",
      active: pathname.startsWith("/core-rulebook/"),
      subItems: coreRulebookSubItems,
    },
    gearNavItem,
    scenarioNavItem,
  ];
}
---

<AppShell title={title} navItems={navItems} brandHref="/about/">
  <div class="content-grid">
    <slot name="head" slot="head" />
    <slot />
  </div>
</AppShell>
